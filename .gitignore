# --- Windows leg (build_windows.ps1) ---
BUILD_INFO.json
# Anchored: an unanchored "wxWidgets" would also match submodules/wxWidgets.
/wxWidgets/
# Per-library out-of-tree build dirs, created inside each submodule.
build-win-*/
/submodules/ffmpeg-win/
/submodules/*_win.log
/.verify-reloc-*/

# Per-library staging directories. The build scripts remove these on success,
# so they only survive a failed build - which is exactly when you do not want
# them turning up as untracked noise.
/submodules/.openssl_stage/
/submodules/.openssl_ios_stage/
/submodules/.curl_ssl_stage/
/submodules/.shader_translate_stage/
/submodules/.shader_translate_stage_win/
